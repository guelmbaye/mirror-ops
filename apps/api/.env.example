# ============================================================================
# MIRROR OPS — API, configuration locale
#
# Ce fichier est prêt à l'emploi : il fait tourner le parcours complet hors
# ligne, sans PostgreSQL et sans consommer une seule unité YouCam.
#
# Avant toute mise en ligne :
#   1. remplacer MEDIA_SIGNING_SECRET par une vraie valeur aléatoire
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   2. passer sur PostgreSQL
#   3. passer YOUCAM_MODE en live et renseigner les identifiants
#
# Ce fichier n'est pas versionné (.gitignore). Ne jamais y placer une clé
# réelle destinée à être partagée.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_JSON=true

# --- Securite ----------------------------------------------------------------
# L'interface tourne sur :3000 — elle doit etre autorisee explicitement.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MEDIA_SIGNING_SECRET=change-me
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Base de donnees ---------------------------------------------------------
# SQLite suffit en local ; le code est identique sur PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./var/mirror_ops.db
# DATABASE_URL=postgresql+asyncpg://mirror:mirror@localhost:5432/mirror_ops
DB_ECHO=false

# --- Sessions & medias temporaires -------------------------------------------
SESSION_TTL_MINUTES=120
MEDIA_TTL_MINUTES=120
MAX_IMAGE_BYTES=10485760
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320

# --- Stockage ----------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./var/storage

# --- YouCam (Perfect Corp) ---------------------------------------------------
# mock = aucun appel reseau, resultats marques « simulated »
# live = appels reels Skin AI + Apparel VTO
#
# C'EST CE FICHIER QUI FAIT FOI pour l'API. Le .env a la racine du depot ne
# sert qu'a docker-compose et n'est pas lu par le processus uvicorn.
# Apres modification : redemarrer l'API, puis verifier
#   curl localhost:8000/api/v1/health/dependencies
# qui doit repondre "youcam": "configured".
YOUCAM_MODE=mock
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# --- Authentification --------------------------------------------------------
# api_key = API v2 (recommandee) : pas d'endpoint d'authentification, la cle
# part directement en `Authorization: Bearer`.
# La cle se cree ici : https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_AUTH_MODE=api_key
YOUCAM_API_KEY=

# client_credentials = API v1 (heritee). Dans la console YouCam, l'« API Key »
# est le client_id et la « Secret key » est le client_secret ; la Secret key
# n'est affichee qu'a sa creation. Ce mode exige en plus une cle publique RSA
# pour construire le id_token.
# YOUCAM_AUTH_MODE=client_credentials
YOUCAM_CLIENT_ID=
YOUCAM_CLIENT_SECRET=
YOUCAM_SECRET_KEY=

YOUCAM_TIMEOUT_MS=30000
YOUCAM_MAX_RETRIES=2
YOUCAM_POLL_INTERVAL_MS=1200
YOUCAM_POLL_TIMEOUT_MS=90000
YOUCAM_CACHE_TTL_SECONDS=900

# Chemins v2. Attention : la fonctionnalite vetement s'appelle « cloth ».
YOUCAM_SKIN_FILE_PATH=/s2s/v2.0/file/skin-analysis
YOUCAM_SKIN_TASK_PATH=/s2s/v2.0/task/skin-analysis
YOUCAM_VTO_FILE_PATH=/s2s/v2.0/file/cloth
YOUCAM_VTO_TASK_PATH=/s2s/v2.0/task/cloth
YOUCAM_TASK_ID_IN_PATH=true
YOUCAM_SKIN_RESULT_FORMAT=json
# HD et SD ne se melangent pas dans une meme requete.
YOUCAM_SKIN_ACTIONS=hd_redness,hd_oiliness,hd_texture,hd_radiance

# --- Moteur ONE CHANGE -------------------------------------------------------
# Seuils de decision. Les faire bouger change le comportement du produit :
# relancer `python scripts/calibrate_engine.py` apres toute modification.
ONE_CHANGE_THRESHOLD=60
ONE_CHANGE_NO_CHANGE_MARGIN=2
ONE_CHANGE_TIE_DELTA=5
ONE_CHANGE_MIN_DATA_CONFIDENCE=0.35
