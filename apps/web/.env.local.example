# ============================================================================
# MIRROR OPS — interface, configuration locale
#
# Cette valeur est compilee dans le bundle client : la modifier impose un
# rebuild (`npm run dev` relance, `npm run build` pour la production).
#
# Aucune cle YouCam ici. Le navigateur ne parle jamais au provider : il ne
# connait que l'API MIRROR OPS.
# ============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Origine publique du site, pour les images de partage (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
