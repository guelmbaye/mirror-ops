{
  // Les tests sont verifies a part : meme rigueur, hors du chemin du build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".next"]
}
