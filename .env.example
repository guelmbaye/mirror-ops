# ============================================================================
# MIRROR OPS — variables lues par docker-compose
#
# Utilise uniquement par `docker compose up`. En developpement sans Docker,
# ce sont apps/api/.env et apps/web/.env.local qui font foi.
# ============================================================================

# mock = parcours complet hors ligne · live = appels YouCam reels
YOUCAM_MODE=mock
YOUCAM_CLIENT_ID=
YOUCAM_CLIENT_SECRET=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_SIGNING_SECRET=dev-secret-change-me

# Le navigateur appelle l'API depuis la machine hote, pas depuis le reseau
# Docker : c'est bien localhost qu'il faut compiler ici.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
